# Render 生产环境变量（填入 Render Dashboard → Environment）
NODE_ENV=production
PORT=10000
DEEPSEEK_API_KEY=sk-your-deepseek-key
BLOG_API_TOKEN=replace-with-a-long-random-blog-token
PAYPAL_EMAIL=https://paypal.me/your-username
PAYPAL_MODE=live
DOMAIN=https://your-render-backend.onrender.com
CORS_ORIGIN=https://mychinesename.co
LOG_LEVEL=error
